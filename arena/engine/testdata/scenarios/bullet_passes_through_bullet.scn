name: bullet - two bullets meeting in flight pass through each other
seed: 1
map: |
  #########
  #A.....B#
  #########
bots:
  A: script fire E
  B: script fire W
beats: 2
expect:
  beat 1: no Hit
  beat 2: Hit B W
  beat 2: Hit A E
  final: A.hp 3
  final: B.hp 3
frame 1: |                # both end on the same cell, B's tracer hidden under A's
  #########
  #A..*..B#
  #########
