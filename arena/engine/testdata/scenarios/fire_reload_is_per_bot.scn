name: fire - every bot has its own gun, one bot's shot does not reload or empty another's
seed: 1
map: |
  #######
  #A...B#
  #######
bots:
  A: script fire E, fire E
  B: script wait, fire W
beats: 2
expect:
  beat 1: Fired A E
  beat 1: no Clicked
  beat 2: Clicked A E
  beat 2: Fired B W
  beat 2: Hit B W            # A's beat-1 bullet (flew to x=4) reaches B at x=5
  final: B.cooldown 2
  final: A.cooldown 1
