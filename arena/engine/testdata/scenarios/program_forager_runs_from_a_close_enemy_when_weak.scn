name: program - Forager looks around and runs from an enemy one lane off when it is not healthy
rules: coin_every=0
seed: 1
map: |
  ##########
  #A....$..#
  #....B...#
  #........#
  ##########
start:
  A: hp=2
bots:
  A: program forager
  B: script wait
beats: 4
expect:
  beat 1: Moved A E
  beat 2: Scanned A E 2 3 0     # enemy one lane off (2), the coin on the line (3)
  at beat 2: A.hp 2
  beat 3: Moved A W            # not healthy (hp 2): runs, away from the enemy's lane (seed 1 picks W of N, S, W)
