name: program - pins are kept through death and a hot-swap, like num
seed: 1
map: |
  #########
  #B..A...#
  #########
start:
  A: hp=1
bots:
  A: program |
    function loop() {
      if (num[0] == 0) { pin[2] = here(); num[0] = 1; }
      wait();
    }
  B: script fire E
edits:
  beat 9: A program |
    function loop() {
      pin[3] = pin[2];
      wait();
    }
beats: 10
expect:
  beat 1: Killed B A
  at beat 1: A.pin_2_set 1
  at beat 1: A.pin_2_x 4
  at beat 3: A.pin_2_x 4         # dead: untouched
  at beat 6: A.alive 1
  at beat 8: A.x 7               # respawned on another cell than the pinned one
  at beat 8: A.pin_2_x 4         # kept through the respawn, never re-pinned
  at beat 8: A.pin_3_set 0
  at beat 9: A.pin_3_set 1       # the new code copies it
  final: A.pin_3_x 4
  final: A.pin_3_y 1
