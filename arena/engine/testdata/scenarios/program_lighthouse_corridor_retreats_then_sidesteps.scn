  beat 2: no Hit
  at beat 2: A.num_1 -1       # sidestep pending
  beat 3: Moved A N
  beat 3: no Hit
  beat 4: no Hit
  final: A.hp 4
  final: A.x 4
  final: A.y 1
  final: A.num_1 0
