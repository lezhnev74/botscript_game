name: program - Lighthouse in a walled corridor sees bullet 3, backs off to a side opening and sidesteps the next beat
seed: 1
map: |
  ##############
  ####.#########
  #....A......B#
  ##############
bullets:
  11,2,W,B
bots:
  A: program lighthouse
  B: script wait
beats: 4
expect:
  beat 1: Scanned A E 3 0 3
