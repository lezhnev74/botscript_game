name: coin - hits run before coins: a 1-HP bot that steps onto a coin and is killed the same beat does not take it
rules: coin_every=0
seed: 1
map: |
  #######
  #A..$B#
  #######
start:
  B: hp=1
bots:
  A: script fire E
  B: script move W
beats: 1
expect:
  beat 1: Moved B W
  beat 1: Killed A B
  beat 1: no CoinTaken
  final: B.alive 0
  final: B.bonus 0
frame 1: |
  #######
  #A..$.#
  #######
