name: program - Lighthouse sweeps clockwise, fires when the enemy is on its line and the gun is loaded
seed: 1
map: |
  #########
  #A.....B#
  #########
bots:
  A: program lighthouse
  B: script wait
beats: 3
expect:
  at beat 1: A.num_0 1          # num[0] = sweep direction, first pass: right(N) = E
  beat 1: Scanned A E 3 0 0
  beat 2: Fired A E
  beat 3: Hit B W
  final: B.hp 3
