name: shield - a respawned bot is protected for shield_beats (2) beats, then vulnerable
rules: respawn_beats=1 reload=1
seed: 1
map: |
  #######
  #AB...#
  #######
start:
  B: hp=1
bots:
  A: script fire E, wait, fire E, fire E, wait
  B: script wait
beats: 5
expect:
  beat 1: Killed A B
  beat 2: Respawned B 5 1
  at beat 2: B.shield 2
  beat 4: no Hit
  at beat 4: B.hp 4
  beat 5: Hit B W
  final: B.hp 3
  final: B.shield 0
