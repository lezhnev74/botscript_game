name: program - a hot-swap keeps the scan readings (enemy, last) and the trail for the new code
seed: 1
map: |
  #########
  #A.....B#
  #########
bots:
  A: program |
    function loop() { scan(E); }
  B: script wait
edits:
  beat 3: A program |
    function loop() {
      if (enemy == 3 && last == E && trail.length == 2 && trail[0].act == SCAN) num[0] = 1;
      else num[0] = 2;
      wait();
    }
beats: 3
expect:
  beat 1: Scanned A E 3 0 0
  beat 2: Scanned A E 3 0 0
  at beat 3: A.num_0 1          # the new code saw enemy 3, last E and two SCAN entries in the trail
